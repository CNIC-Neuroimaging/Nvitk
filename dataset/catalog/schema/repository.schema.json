{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NVITK Study Dataset Repository Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_name",
    "table_root",
    "cache_root",
    "tables_manifest",
    "variables_manifest",
    "sqlite_index_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "table_root": {
      "type": "string"
    },
    "cache_root": {
      "type": "string"
    },
    "tables_manifest": {
      "type": "string"
    },
    "variables_manifest": {
      "type": "string"
    },
    "sqlite_index_path": {
      "type": "string"
    }
  }
}
