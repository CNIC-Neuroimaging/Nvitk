{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BioImaging Models Registry Schema",
  "description": "Schema for the BioImaging-Models registry system",
  "version": "1.0",
  
  "type": "object",
  "required": ["schema_version", "last_updated", "infrastructure", "models"],
  
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this schema"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last registry update"
    },
    "infrastructure": {
      "type": "object",
      "required": ["model_storage"],
      "properties": {
        "model_storage": {
          "type": "string",
          "description": "Root path to model storage on server"
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Registry of all models",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "$ref": "#/definitions/model"
        }
      }
    }
  },
  
  "definitions": {
    "model": {
      "type": "object",
      "required": ["category", "type", "latest", "versions"],
      "properties": {
        "category": {
          "type": "string",
          "description": "Model category path"
        },
        "type": {
          "type": "string",
          "description": "Model task type",
          "enum": ["segmentation", "classification", "detection", "embedding", "generation"]
        },
        "latest": {
          "type": "string",
          "description": "Latest version number"
        },
        "versions": {
          "type": "object",
          "description": "All versions of this model",
          "patternProperties": {
            "^[0-9]+\\.[0-9]+\\.[0-9]+$": {
              "$ref": "#/definitions/version"
            }
          }
        }
      }
    },
    
    "version": {
      "type": "object",
      "required": ["git_tag", "added_date", "location"],
      "properties": {
        "git_tag": {
          "type": "string",
          "description": "Git tag for this version"
        },
        "git_commit": {
          "type": "string",
          "description": "Git commit hash"
        },
        "added_date": {
          "type": "string",
          "format": "date-time",
          "description": "Date this version was added"
        },
        "location": {
          "type": "string",
          "description": "Server path to model files"
        },
        "files": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of weight files"
        },
        "config_files": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of config files"
        },
        "size_mb": {
          "oneOf": [
            {"type": "number"},
            {"type": "string", "enum": ["unknown"]}
          ],
          "description": "Total size in MB or 'unknown'"
        },
        "source": {
          "type": "string",
          "description": "Source type",
          "enum": ["pretrained", "trained-inhouse", "external", "unknown"]
        },
        "compatible_containers": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of compatible containers"
        },
        "deprecated": {
          "type": "boolean",
          "description": "Whether this version is deprecated"
        },
        "deprecation_reason": {
          "type": "string",
          "description": "Reason for deprecation"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes"
        },
        "structure": {
          "type": "string",
          "description": "Special structure type (e.g., 'nnunet_results')"
        }
      }
    }
  }
}

