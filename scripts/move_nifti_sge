#!/usr/bin/env bash
# Sync qvtpy NIfTI subject trees between cluster/network and local storage.
#
# Default direction (cluster -> local):
#   remote/<subject>/{TOF,4DFlow,...}  ->  local/<subject>/
#
# With --to-network (local -> cluster):
#   local/<subject>/  ->  remote/<subject>/
#
# Example (pull from SGE to workstation):
#   ./scripts/move_nifti_sge \
#     --subjects-csv pesabrain_qvtpy_eligible.csv \
#     --local-root /home/imarcoss/NetVolumes/LAB_MCC/LabVF/PESA-Brain/DATA/NIFTI \
#     --remote imarcoss@10.149.80.46:/data_lab_MCC/imarcoss/LabMCC/DATA/NIFTI
#
# Example (push back to network):
#   ./scripts/move_nifti_sge --to-network \
#     --subjects-csv pesabrain_qvtpy_eligible.csv \
#     --local-root /home/imarcoss/NetVolumes/LAB_MCC/LabVF/PESA-Brain/DATA/NIFTI \
#     --remote imarcoss@10.149.80.46:/data_lab_MCC/imarcoss/LabMCC/DATA/NIFTI

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_qvtpy_move_common.sh
source "${SCRIPT_DIR}/_qvtpy_move_common.sh"

DEFAULT_LOCAL="/home/imarcoss/NetVolumes/LAB_MCC/LabVF/PESA-Brain/DATA/NIFTI"
DEFAULT_REMOTE="imarcoss@10.149.80.46:/data_lab_MCC/imarcoss/LabMCC/DATA/NIFTI"

SUBJECTS_CSV=""
LOCAL_ROOT="$DEFAULT_LOCAL"
REMOTE_ROOT="$DEFAULT_REMOTE"
TO_NETWORK=0
DRY_RUN=0

usage() {
  cat <<EOF
Usage: $(basename "$0") --subjects-csv FILE [options]

Sync qvtpy NIfTI subject folders (TOF/, 4DFlow/, ...) between local and
network/cluster roots via rsync.

Required:
  --subjects-csv PATH   CSV with a subject_id (or subject) column

Options:
  --local-root PATH     Local NIfTI root (default: ${DEFAULT_LOCAL})
  --remote PATH         Remote NIfTI root as user@host:path
                        (default: ${DEFAULT_REMOTE})
  --to-network          Push local -> remote (default: pull remote -> local)
  --dry-run             Pass --dry-run to rsync
  -h, --help            Show this help

Each subject syncs the full subject directory:
  <root>/<subject>/  (TOF/, 4DFlow/, ...)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --subjects-csv)
      SUBJECTS_CSV="${2:-}"
      shift 2
      ;;
    --local-root)
      LOCAL_ROOT="${2:-}"
      shift 2
      ;;
    --remote)
      REMOTE_ROOT="${2:-}"
      shift 2
      ;;
    --to-network)
      TO_NETWORK=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage_die "Unknown argument: $1"
      ;;
  esac
done

[[ -n "$SUBJECTS_CSV" ]] || usage_die "--subjects-csv is required."
is_remote_path "$REMOTE_ROOT" || die "--remote must be user@host:path"

mapfile -t SUBJECTS < <(read_subjects_csv "$SUBJECTS_CSV")
[[ ${#SUBJECTS[@]} -gt 0 ]] || die "No subjects found in $SUBJECTS_CSV"

if [[ "$TO_NETWORK" == "1" ]]; then
  direction="local -> network"
  src_root="${LOCAL_ROOT%/}"
  dest_root="${REMOTE_ROOT%/}"
  [[ -d "$src_root" ]] || die "Local root not found: $src_root"
else
  direction="network -> local"
  src_root="${REMOTE_ROOT%/}"
  dest_root="${LOCAL_ROOT%/}"
  ensure_dir "$dest_root"
fi

echo "Moving NIfTI for ${#SUBJECTS[@]} subject(s) (${direction})"
echo "  from: ${src_root}"
echo "  to:   ${dest_root}"
[[ "$DRY_RUN" == "1" ]] && echo "  mode: dry-run"

failed=0
for subject in "${SUBJECTS[@]}"; do
  if [[ "$TO_NETWORK" == "1" ]]; then
    src="${src_root}/${subject}"
    dest="${dest_root}/${subject}"
    if [[ ! -d "$src" ]]; then
      echo "SKIP ${subject}: missing local source ${src}" >&2
      failed=$((failed + 1))
      continue
    fi
    ensure_dir "$dest"
    run_rsync "${src}/" "${dest}/"
  else
    src="${src_root}/${subject}"
    dest="${dest_root}/${subject}"
    if [[ "$DRY_RUN" != "1" ]]; then
      remote_host="$(remote_host_from_path "$src")"
      remote_path="$(remote_path_from_path "$src")"
      if ! ssh "$remote_host" "test -d $(printf '%q' "$remote_path")"; then
        echo "SKIP ${subject}: missing remote source ${src}" >&2
        failed=$((failed + 1))
        continue
      fi
    fi
    ensure_dir "$dest"
    run_rsync "${src}/" "${dest}/"
  fi
done

if [[ "$failed" -gt 0 ]]; then
  die "${failed} subject(s) skipped (missing source)."
fi

echo "Done."
