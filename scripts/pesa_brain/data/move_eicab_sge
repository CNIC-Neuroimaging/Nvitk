#!/usr/bin/env bash
# Sync qvtpy eICAB results from a local results tree to a network/cluster tree.
#
# Input layout:  <input-root>/<subject>/eicab/*
# Output layout: <output-root>/<subject>/eicab/*
#
# Example:
#   ./scripts/move_eicab_sge \
#     --subjects-csv pesabrain_qvtpy_eligible.csv \
#     --input /home/imarcoss/DATA/LabVF/res_QVTPy \
#     --output imarcoss@10.149.80.46:/data_lab_MCC/imarcoss/LabMCC/RESULTS/QVTPy

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_qvtpy_move_common.sh
source "${SCRIPT_DIR}/_qvtpy_move_common.sh"

DEFAULT_INPUT="/home/imarcoss/DATA/LabVF/res_QVTPy"
DEFAULT_OUTPUT="imarcoss@10.149.80.46:/data_lab_MCC/imarcoss/LabMCC/RESULTS/QVTPy"

SUBJECTS_CSV=""
INPUT_ROOT="$DEFAULT_INPUT"
OUTPUT_ROOT="$DEFAULT_OUTPUT"
DRY_RUN=0

usage() {
  cat <<EOF
Usage: $(basename "$0") --subjects-csv FILE [options]

Move qvtpy eICAB outputs from a local results root to a network results root
via rsync. Remote destination directories are created when missing.

Required:
  --subjects-csv PATH   CSV with a subject_id (or subject) column

Options:
  --input PATH          Local source results root
                        (default: ${DEFAULT_INPUT})
  --output PATH         Destination results root (local path or user@host:path)
                        (default: ${DEFAULT_OUTPUT})
  --dry-run             Pass --dry-run to rsync
  -h, --help            Show this help

Each subject syncs:
  <input>/<subject>/eicab/  ->  <output>/<subject>/eicab/
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --subjects-csv)
      SUBJECTS_CSV="${2:-}"
      shift 2
      ;;
    --input)
      INPUT_ROOT="${2:-}"
      shift 2
      ;;
    --output)
      OUTPUT_ROOT="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage_die "Unknown argument: $1"
      ;;
  esac
done

[[ -n "$SUBJECTS_CSV" ]] || usage_die "--subjects-csv is required."
[[ -d "$INPUT_ROOT" ]] || die "Input root not found: $INPUT_ROOT"

mapfile -t SUBJECTS < <(read_subjects_csv "$SUBJECTS_CSV")
[[ ${#SUBJECTS[@]} -gt 0 ]] || die "No subjects found in $SUBJECTS_CSV"

echo "Moving eICAB results for ${#SUBJECTS[@]} subject(s)"
echo "  from: ${INPUT_ROOT}"
echo "  to:   ${OUTPUT_ROOT}"
[[ "$DRY_RUN" == "1" ]] && echo "  mode: dry-run"

failed=0
for subject in "${SUBJECTS[@]}"; do
  src="${INPUT_ROOT%/}/${subject}/eicab"
  dest="${OUTPUT_ROOT%/}/${subject}/eicab"

  if [[ ! -d "$src" ]]; then
    echo "SKIP ${subject}: missing source ${src}" >&2
    failed=$((failed + 1))
    continue
  fi

  echo "==> ${subject}"
  ensure_dir "$dest"
  run_rsync "${src}/" "${dest}/"
done

if [[ "$failed" -gt 0 ]]; then
  die "${failed} subject(s) skipped (missing source eicab/)."
fi

echo "Done."
