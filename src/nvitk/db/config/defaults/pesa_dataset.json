  "cohort_dir_rules": {
    "reject_prefixes": [
      "."
    ],
    "reject_startswith": [
      "res_"
    ],
    "reject_upper_prefixes": [
      "PESA"
    ],
    "accept_regex": [
      "^\\d{6}_Week\\d+$"
    ],
    "accept_regex_flags": "i",
    "accept_upper_prefixes": [
      "DIXON_"
    ],
    "accept_prefixes": [
      "Visit-"
    ]
  },
  "plaque_source_filename": "PESABrain_Echography_CarotidePlaque_20260216.xlsx"
