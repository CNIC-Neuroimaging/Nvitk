  "local_presets": [
    {
      "preset_id": "qvtpy",
      "label": "QVTpy (4D flow)",
      "config_module": "nvitk.pipes.qvtpy.config",
      "layout": "flat",
      "subject_globs": [
        "PESA*"
      ],
      "show_batch": false,
      "default_batch": "",
      "pesa_fat_layout": false
    },
    {
      "preset_id": "pesa_fat",
      "label": "PESA-Fat (Dixon + CT-PET)",
      "config_module": "nvitk.pipes.pesa_fat.common.paths",
      "layout": "batch",
      "subject_globs": [
        "PESA*"
      ],
      "show_batch": true,
      "default_batch": "",
      "pesa_fat_layout": true
    },
    {
      "preset_id": "pesa_fat_ctpet",
      "label": "PESA-Fat CT-PET v5",
      "config_module": "nvitk.pipes.pesa_fat.common.paths",
