# Data files (edit to your needs)
data/
results/
outputs/
# Dataset content is tracked by DVC, not git: the bytes live on the DVC remote and only the
# small *.dvc pointer files are versioned here. The negations matter — a blanket `dataset/`
# rule silently makes the pointers unstageable, and DVC then appears to work while nothing is
# actually versioned.
dataset/
!dataset/**/
!dataset/**/*.dvc
!dataset/**/.gitignore

# Large microscopy / imaging files (edit extensions as needed)
*.tif
*.tiff
*.nii
*.nii.gz
*.h5
*.hdf5